# ---------- проект пользователя (агент) ----------
# Файл с агентом и функция-точка входа
AGENT_PATH=/abs/path/to/user_project/src/additional_products.py
AGENT_FUNC=detect_additional_products
# Корень импорта проекта (в sys.path). Если не задан - папка файла агента.
# Нужен, когда агент делает `from src.xxx import ...`: тогда AGENT_ROOT=/abs/path/to/user_project
AGENT_ROOT=/abs/path/to/user_project
# Свой .env проекта (ключи/сертификаты агента), грузится ДО импорта агента
AGENT_ENV_FILE=/abs/path/to/user_project/.env
# Поле ответа агента с булевым вердиктом
AGENT_VERDICT_FIELD=has_additional_products
# Необязательно: атрибут модуля агента с промптом-справочником для генератора синтетики
AGENT_PROMPT_ATTR=SYSTEM_PROMPT

# ---------- датасет (по умолчанию лежит в ./data) ----------
DATASET_PATH=data/dataset.xlsx
DATASET_TEXT_COL=text
DATASET_LABEL_COL=label
# Колонка с готовыми предсказаниями агента на оригиналах. Пусто -> агент прогоняется по оригиналам.
DATASET_PRED_COL=has_additional_products

# ---------- LLM-генератор синтетики (mTLS GigaChat) ----------
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_CA_BUNDLE_FILE=
GIGACHAT_CERT_FILE=
GIGACHAT_KEY_FILE=
GIGACHAT_MODEL=GigaChat-3-Ultra-preview
GIGACHAT_TEMPERATURE=0
GIGACHAT_TIMEOUT=90
GIGACHAT_MAX_RETRIES=3
GIGACHAT_RETRY_DELAY=3

OUT_DIR=runs
